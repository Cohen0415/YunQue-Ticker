/* 用户输入框 */
#inputLineEdit {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 16px;
    min-width: 180px;
}

#inputErrHintLabel {
	color: #fa5555;
}

/* 添加自选按钮、添加组合按钮 */
#addNewPortfolioBtn, #addNewStockBtn {
    background-color: #238dfa;
    color: #fff;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    margin-right: 10px;
}
#addNewPortfolioBtn:hover, #addNewStockBtn:hover {
    background-color: #096dd9;
}

/* 下拉框 */
#portfolioComboBox {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 16px;
    min-width: 140px;
}

/* 删除组合按钮（红色） */
#delPortfolioBtn {
    background-color: #fa5555;
    color: #fff;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    margin-left: 10px;
}
#delPortfolioBtn:hover {
    background-color: #c32222;
}